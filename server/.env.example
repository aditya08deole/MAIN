# Core
PROJECT_NAME="EvaraTech Backend"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database (Supabase)
# Pooler via IPv4 (bypassing DNS/IPv6 glitches)
DATABASE_URL="postgresql+asyncpg://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require"

# Supabase Auth & Admin
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_JWT_SECRET="your-jwt-secret-here"

# Backend CORS (Allow Frontend)
BACKEND_CORS_ORIGINS="http://localhost:8080,http://localhost:5173"

# Logging
LOG_LEVEL="INFO"
