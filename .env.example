# EvaraTech Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# PROJECT CONFIGURATION
# ============================================================================
PROJECT_NAME="EvaraTech Backend"
ENVIRONMENT="development"  # Options: development, staging, production

# ============================================================================
# DATABASE (Supabase PostgreSQL)
# ============================================================================
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Note: Use port 6543 for Supabase connection pooler (required for external access)
# Note: Use port 5432 only for direct connection (not recommended for production)
DATABASE_URL="postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Supabase Project URL (e.g., https://abcdefgh.supabase.co)
SUPABASE_URL="https://<project-ref>.supabase.co"

# JWT Secret for token verification (Settings → API → JWT Secret)
SUPABASE_JWT_SECRET="your-jwt-secret-here"

# Service Role Key (Settings → API → service_role key)
# WARNING: Keep this secret! Bypasses Row Level Security
SUPABASE_KEY="your-service-role-key-here"

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:8080,https://your-frontend-url.onrender.com"

# ============================================================================
# LOGGING
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# ============================================================================
# SECURITY (Optional)
# ============================================================================
# Secret key for session management (auto-generated in production)
# SECRET_KEY="your-secret-key-here"

# Dev bypass control (should be false in production)
ALLOW_DEV_BYPASS="true"  # Set to "false" in production

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================
# ThingSpeak API configuration (if using centralized keys)
# THINGSPEAK_API_KEY="your-thingspeak-api-key"

# ============================================================================
# DEPLOYMENT (Render-specific)
# ============================================================================
# Port for the backend server (Render uses PORT environment variable)
# PORT=8000  # Uncomment if needed locally
